  "glossary": [
    {"id": "x-men_term_x-gene", "name": "X-Gene", "kind": "keyword", "summary": "A bonus you get only if your discard pile already holds a card of the class shown. Each card gives its bonus once, however many matches you have.", "source": "XM", "page": 1},
    {"id": "x-men_term_piercing-energy", "name": "Piercing Energy", "kind": "keyword", "summary": "A third kind of points: pay an enemy's printed Victory Points in it to beat that enemy, ignoring its Attack and fight conditions. Enemies with no printed Victory Points are immune.", "source": "XM", "page": 1},
    {"id": "x-men_term_berserk", "name": "Berserk", "kind": "keyword", "summary": "Throw away the top card of your deck and gain Attack equal to the Attack printed on it.", "source": "XM", "page": 1},
    {"id": "x-men_term_soaring-flight", "name": "Soaring Flight", "kind": "keyword", "summary": "A Hero recruited with this skips your discard pile: it waits aside until the turn ends, then goes into your new hand as a bonus card.", "source": "XM", "page": 1},
    {"id": "x-men_term_lightshow", "name": "Lightshow", "kind": "keyword", "summary": "Play two or more Lightshow cards in a turn to use one Lightshow bonus among them, never more than one a turn.", "source": "XM", "page": 1},
    {"id": "x-men_term_dominate", "name": "Dominate", "kind": "keyword", "summary": "An enemy keeps Heroes tucked under it and grows 1 stronger for each. Beating it deals those Heroes out to the players' discard piles.", "source": "XM", "page": 1},
    {"id": "x-men_term_human-shields", "name": "Human Shields", "kind": "keyword", "summary": "Bystanders an enemy grabs face down. It can't be fought while it has any, but you can pay to free them one at a time.", "source": "XM", "page": 1},
    {"id": "x-men_term_trap", "name": "Trap", "kind": "keyword", "summary": "A Villain Deck card that sets a task for the turn instead of entering the city. Meet it to score the Trap, or KO it and take its penalty.", "source": "XM", "page": 1},
    {"id": "x-men_term_horror", "name": "Horror", "kind": "keyword", "summary": "Extra hazard cards that make the game harder. Epic Masterminds and some Schemes play them, and players may add any number at the start.", "source": "XM", "page": 2}
  ]
}
