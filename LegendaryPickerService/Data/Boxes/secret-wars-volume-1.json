  "glossary": [
    { "id": "secret-wars-volume-1_term_illuminati", "name": "Illuminati", "kind": "team", "summary": "A Hero team. In Secret Wars Volume 1 its members are Black Bolt, Black Panther, Dr. Strange and Superior Iron Man.", "source": "SW1", "page": 1 },
    { "id": "secret-wars-volume-1_term_cabal", "name": "Cabal", "kind": "team", "summary": "A Hero team. In Secret Wars Volume 1 its members are Maximus, Namor, Proxima Midnight and Thanos.", "source": "SW1", "page": 1 },
    { "id": "secret-wars-volume-1_term_multiclass", "name": "Multiclass", "kind": "keyword", "summary": "A Hero card showing two class icons counts as both classes, so it can switch on Superpower abilities that ask for either one.", "source": "SW1", "page": 1 },
    { "id": "secret-wars-volume-1_term_sidekick", "name": "Sidekick", "kind": "keyword", "summary": "A shared stack of cheap Hero cards. Each player can recruit at most one Sidekick a turn; Sidekicks gained through card effects ignore that limit.", "source": "SW1", "page": 1 },
    { "id": "secret-wars-volume-1_term_rise-of-the-living-dead", "name": "Rise of the Living Dead", "kind": "keyword", "summary": "Every player checks the top card of their Victory Pile, and a Villain there with this ability goes back into the city. Mastermind Tactics never come back this way.", "source": "SW1", "page": 1 },
    { "id": "secret-wars-volume-1_term_cross-dimensional-rampage", "name": "Cross-Dimensional Rampage", "kind": "keyword", "summary": "Every player shows a Hero, or a card in their Victory Pile, of the named character, such as Hulk or Wolverine, or takes a Wound.", "source": "SW1", "page": 1 },
    { "id": "secret-wars-volume-1_term_ambition", "name": "Ambition", "kind": "keyword", "summary": "A card for the optional mode where one player is the Mastermind. That player reveals them into an Ambition Row and plays one by spending the Attack shown on it.", "source": "SW1", "page": 1 },
    { "id": "secret-wars-volume-1_term_multiple-masterminds", "name": "Multiple Masterminds", "kind": "keyword", "summary": "Some escaping Villains and some Schemes put another Mastermind in play. Players must beat every Mastermind to win, and each one resolves its own Master Strike.", "source": "SW1", "page": 1 }
  ]
}
