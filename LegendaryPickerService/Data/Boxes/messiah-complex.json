    {"id": "messiah-complex_term_clone", "name": "Clone", "kind": "keyword", "summary": "Take one more copy of the same card into your discard pile, from the HQ or else from its deck or stack, then shuffle that deck. A Villain's Clone brings a copy from the Villain Deck into the city.", "source": "MC", "page": 1},
    {"id": "messiah-complex_term_shatter", "name": "Shatter", "kind": "keyword", "summary": "Cuts a Villain's current fight value in half, rounding up, until the turn ends, and can be repeated. Some cards shatter the Mastermind for one fight, or halve an HQ Hero's cost.", "source": "MC", "page": 1},
