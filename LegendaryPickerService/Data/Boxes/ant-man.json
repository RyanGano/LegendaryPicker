    {"id": "ant-man_term_microscopic-size-changing", "name": "Microscopic Size-Changing", "kind": "keyword", "summary": "Like Size-Changing, but the cost or fight value drops 2 for each card played, up to the number of icons shown. It can fall below zero, and a negative value gives that many points.", "source": "AM", "page": 1},
    {"id": "ant-man_term_empowered", "name": "Empowered", "kind": "keyword", "summary": "The card gets +1 for each card of the shown color in the HQ, counted when you play the Hero or fight the enemy. Double and Triple Empowered give +2 and +3.", "source": "AM", "page": 1},
    {"id": "ant-man_term_chivalrous-duel", "name": "Chivalrous Duel", "kind": "keyword", "summary": "To fight this enemy you can use points only from Heroes sharing one Hero Name. Points from anything that isn't a Hero card don't count.", "source": "AM", "page": 2},
