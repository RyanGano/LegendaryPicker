  "glossary": [
    { "id": "secret-wars-volume-2_term_spectrum", "name": "Spectrum", "kind": "keyword", "summary": "Spectrum abilities switch on only when a player's hand and cards played this turn show at least three different Hero classes. Multiclass cards count toward every class they show.", "source": "SW2", "page": 1 },
    { "id": "secret-wars-volume-2_term_patrol", "name": "Patrol", "kind": "keyword", "summary": "A Patrol ability looks at one named city space or pile when it is used. It works only while that place is empty, and never for a space a Scheme or Mastermind has removed.", "source": "SW2", "page": 1 },
    { "id": "secret-wars-volume-2_term_circle-of-kung-fu", "name": "Circle of Kung-Fu", "kind": "keyword", "summary": "A numbered Circle raises an enemy's Attack unless the player reveals a Hero costing at least that number. If several Circles apply, only the highest counts.", "source": "SW2", "page": 1 },
    { "id": "secret-wars-volume-2_term_fateful-resurrection", "name": "Fateful Resurrection", "kind": "keyword", "summary": "When a card with this Fight effect is defeated, check the top of the Villain Deck. A Twist or Strike there sends the defeated card back into the city.", "source": "SW2", "page": 1 },
    { "id": "secret-wars-volume-2_term_charge", "name": "Charge", "kind": "keyword", "summary": "After a charging card enters the city, it advances the stated number of extra spaces. It pushes Villains ahead of it and can make them escape.", "source": "SW2", "page": 1 }
  ]
