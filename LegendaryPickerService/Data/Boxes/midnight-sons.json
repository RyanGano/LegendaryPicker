 "glossary": [
  {
   "id": "midnight-sons_term_blood-frenzy",
   "name": "Blood Frenzy",
   "kind": "keyword",
   "summary": "The bonus equals how many different Victory Point values your Victory Pile holds. On a Villain it raises its Attack, but only during your turn.",
   "source": "MS",
   "page": 1
  },
  {
   "id": "midnight-sons_term_hunt-for-victims",
   "name": "Hunt for Victims",
   "kind": "keyword",
   "summary": "The card preys on Bystanders: it KOs one that is held captive or sits in the Escape Pile, or captures a new one if none is available.",
   "source": "MS",
   "page": 1
  },
  {
   "id": "midnight-sons_term_haunt",
   "name": "Haunt",
   "kind": "keyword",
   "summary": "A Villain slips under an HQ Hero and blocks it from being recruited. A player can spend Recruit equal to that Hero's cost to exorcise it, driving the Villain out into the city.",
   "source": "MS",
   "page": 1
  },
  {
   "id": "midnight-sons_term_moonlight-and-sunlight",
   "name": "Moonlight and Sunlight",
   "kind": "keyword",
   "summary": "Moonlight abilities work when most HQ Heroes have odd printed costs, Sunlight abilities when most have even ones. A tie turns both off.",
   "source": "MS",
   "page": 2
  }
 ]
