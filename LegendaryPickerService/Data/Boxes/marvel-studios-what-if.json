  "glossary": [
    {
      "id": "marvel-studios-what-if_term_guardians-of-the-multiverse",
      "name": "Guardians of the Multiverse",
      "kind": "team",
      "summary": "A team of Heroes from different realities, gathered by Uatu the Watcher. Its icon on a card powers team Superpower abilities.",
      "source": "WI",
      "page": 25
    },
    {
      "id": "marvel-studios-what-if_term_covert",
      "name": "Covert",
      "kind": "class",
      "summary": "Red Heroes who win through trickery, planning and subtle Superpowers.",
      "source": "WI",
      "page": 25
    },
    {
      "id": "marvel-studios-what-if_term_instinct",
      "name": "Instinct",
      "kind": "class",
      "summary": "Yellow Heroes who rely on ferocity, fast reflexes and sharp senses.",
      "source": "WI",
      "page": 25
    },
    {
      "id": "marvel-studios-what-if_term_ranged",
      "name": "Ranged",
      "kind": "class",
      "summary": "Blue Heroes who strike from a distance with projectiles, beams and elemental or mental force.",
      "source": "WI",
      "page": 25
    },
    {
      "id": "marvel-studios-what-if_term_strength",
      "name": "Strength",
      "kind": "class",
      "summary": "Green Heroes who rely on raw power, determination and leadership.",
      "source": "WI",
      "page": 25
    },
    {
      "id": "marvel-studios-what-if_term_tech",
      "name": "Tech",
      "kind": "class",
      "summary": "Black Heroes who rely on gadgets, weapons and advanced science.",
      "source": "WI",
      "page": 25
    },
    {
      "id": "marvel-studios-what-if_term_always-leads",
      "name": "Always Leads",
      "kind": "keyword",
      "summary": "A Mastermind names a group that must be in the Villain Deck whenever that Mastermind is chosen. The other groups are picked at random.",
      "source": "WI",
      "page": 6
    },
    {
      "id": "marvel-studios-what-if_term_ambush",
      "name": "Ambush",
      "kind": "keyword",
      "summary": "A Villain does this the moment it enters the city, after it has moved into the Sewers and any Villain pushed out has escaped.",
      "source": "WI",
      "page": 9
    },
    {
      "id": "marvel-studios-what-if_term_escape",
      "name": "Escape",
      "kind": "keyword",
      "summary": "A Villain does this when it is pushed out of the city into the Escape Pile.",
      "source": "WI",
      "page": 9
    },
    {
      "id": "marvel-studios-what-if_term_fight",
      "name": "Fight",
      "kind": "keyword",
      "summary": "A card does this once a player pays its Attack and defeats it.",
      "source": "WI",
      "page": 13
    },
    {
      "id": "marvel-studios-what-if_term_master-strike",
      "name": "Master Strike",
      "kind": "keyword",
      "summary": "When one is played from the Villain Deck, the Mastermind does the effect on its card, and the Strike is then KO'd.",
      "source": "WI",
      "page": 10
    },
    {
      "id": "marvel-studios-what-if_term_mastermind-tactic",
      "name": "Mastermind Tactic",
      "kind": "keyword",
      "summary": "The Mastermind's four face-down cards. Each fight takes one at random and does its Fight effect.",
      "source": "WI",
      "page": 14
    },
    {
      "id": "marvel-studios-what-if_term_scheme-twist",
      "name": "Scheme Twist",
      "kind": "keyword",
      "summary": "A Villain Deck card that triggers the Scheme's Twist effect when played, then is KO'd unless the Scheme says otherwise.",
      "source": "WI",
      "page": 10
    },
    {
      "id": "marvel-studios-what-if_term_what-if",
      "name": "What If...?",
      "kind": "keyword",
      "summary": "Name a Hero Class or Hero Name, then reveal your top card and keep it or discard it. The ability works only if the card matches.",
      "source": "WI",
      "page": 16
    },
    {
      "id": "marvel-studios-what-if_term_soulbind",
      "name": "Soulbind",
      "kind": "keyword",
      "summary": "Flip a face-up Villain in your Victory Pile face down to power an effect. Until final scoring, that Villain no longer counts as being in your pile.",
      "source": "WI",
      "page": 16
    },
    {
      "id": "marvel-studios-what-if_term_liberate",
      "name": "Liberate",
      "kind": "keyword",
      "summary": "A bonus to Attack that can be used only against a Villain holding Bystanders, or against the Mastermind.",
      "source": "WI",
      "page": 17
    },
    {
      "id": "marvel-studios-what-if_term_empowered",
