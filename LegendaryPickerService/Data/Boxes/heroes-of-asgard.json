    {"id": "heroes-of-asgard_term_worthy", "name": "Worthy", "kind": "keyword", "summary": "You are Worthy while you have a Hero costing 5 or more in hand, played this turn, or controlled as an Artifact.", "source": "HA", "page": 1},
