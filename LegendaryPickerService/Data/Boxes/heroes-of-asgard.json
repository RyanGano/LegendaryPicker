    {"id": "heroes-of-asgard_term_asgard", "name": "Asgard", "kind": "team", "summary": "A Hero team. In this box its members are Beta Ray Bill, Lady Sif, Thor, Valkyrie and The Warriors Three.", "source": "Q", "page": 1},
