  "glossary": [
    { "id": "villains_term_brotherhood", "name": "Brotherhood", "kind": "team", "summary": "An Ally team of mutants who believe their kind should rule. In Villains its members are Juggernaut, Magneto, Mystique and Sabretooth.", "source": "VIL", "page": 19 },
    { "id": "villains_term_crime-syndicate", "name": "Crime Syndicate", "kind": "team", "summary": "An Ally team of street-level crime bosses and hired killers. In Villains its members are Bullseye and Kingpin.", "source": "VIL", "page": 19 },
    { "id": "villains_term_foes-of-asgard", "name": "Foes of Asgard", "kind": "team", "summary": "An Ally team of enemies of Thor's home realm. In Villains its members are Enchantress and Loki.", "source": "VIL", "page": 19 },
    { "id": "villains_term_sinister-six", "name": "Sinister Six", "kind": "team", "summary": "An Ally team of Spider-Man's foes who band together against him. In Villains its members are Dr. Octopus, Electro, Green Goblin, Kraven, Mysterio and Venom.", "source": "VIL", "page": 19 },
    { "id": "villains_term_covert", "name": "Covert", "kind": "class", "summary": "An Ally class that wins through deceit, cunning schemes and subtle powers.", "source": "VIL", "page": 19 },
    { "id": "villains_term_instinct", "name": "Instinct", "kind": "class", "summary": "An Ally class that relies on ferocity, fast reactions and keen senses.", "source": "VIL", "page": 19 },
    { "id": "villains_term_ranged", "name": "Ranged", "kind": "class", "summary": "An Ally class that attacks from afar with blasts, beams and elemental or mental power.", "source": "VIL", "page": 19 },
    { "id": "villains_term_strength", "name": "Strength", "kind": "class", "summary": "An Ally class whose power is raw might, iron will or command of others.", "source": "VIL", "page": 19 },
    { "id": "villains_term_tech", "name": "Tech", "kind": "class", "summary": "An Ally class armed with weapons, gadgets, inventions and advanced science.", "source": "VIL", "page": 19 },
    { "id": "villains_term_always-leads", "name": "Always Leads", "kind": "keyword", "summary": "Names the Adversary Group or Backup Adversary group this Commander brings to every game. It takes one of the setup's group slots; random draws fill the rest.", "source": "VIL", "page": 6 },
    { "id": "villains_term_ambush", "name": "Ambush", "kind": "keyword", "summary": "Triggers as this Adversary arrives in the city. If its arrival pushes another Adversary out, resolve that overrun first.", "source": "VIL", "page": 9 },
    { "id": "villains_term_command-strike", "name": "Command Strike", "kind": "keyword", "summary": "When a Command Strike comes off the Adversary Deck, the Commander acts in person: resolve the Command Strike line on its card, then KO the Strike.", "source": "VIL", "page": 10 },
    { "id": "villains_term_commander-tactic", "name": "Commander Tactic", "kind": "keyword", "summary": "Beating the Commander's Attack takes one of its four face-down Tactics at random for your Victory Pile, with its Fight effect. Taking all four wins.", "source": "VIL", "page": 13 },
    { "id": "villains_term_demolish", "name": "Demolish", "kind": "keyword", "summary": "Reveal the Ally Deck's top card and move it to the bottom; every player then discards a card that costs the same, if they have one.", "source": "VIL", "page": 13 },
    { "id": "villains_term_dodge", "name": "Dodge", "kind": "keyword", "summary": "On your turn you can discard this card from your hand to draw a replacement, ignoring its other text. Dodging is not playing the card.", "source": "VIL", "page": 14 },
    { "id": "villains_term_elusive", "name": "Elusive", "kind": "keyword", "summary": "You can only fight this Adversary once you have made at least the listed amount of Recruit this turn. That Recruit stays yours to spend.", "source": "VIL", "page": 14 },
    { "id": "villains_term_fight", "name": "Fight", "kind": "keyword", "summary": "Triggers when a player spends enough Attack to defeat this card.", "source": "VIL", "page": 12 },
    { "id": "villains_term_kidnap-a-bystander", "name": "Kidnap a Bystander", "kind": "keyword", "summary": "Take the top Bystander of the Bystander Deck into your Victory Pile. It never takes a Bystander an Adversary guards; defeat that Adversary for it.", "source": "VIL", "page": 15 },
    { "id": "villains_term_overrun", "name": "Overrun", "kind": "keyword", "summary": "Triggers when this Adversary is pushed out past the last city space, after it KOs a cheap Ally from the Lair and any guarded Bystanders cost each player a discard.", "source": "VIL", "page": 8 },
    { "id": "villains_term_plot-twist", "name": "Plot Twist", "kind": "keyword", "summary": "Drawing a Plot Twist from the Adversary Deck moves the Commander's plan forward: resolve the Twist line on the Plot, then KO the Twist unless the Plot says otherwise.", "source": "VIL", "page": 9 },
    { "id": "villains_term_x-treme-attack", "name": "X-Treme Attack", "kind": "keyword", "summary": "This Adversary gets +1 Attack for every other Adversary with X-Treme Attack in the city, so these teams grow stronger together.", "source": "VIL", "page": 14 }
  ],
