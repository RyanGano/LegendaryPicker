    { "id": "civil-war_term_divided-card", "name": "Divided Card", "kind": "keyword", "summary": "One card printed as two halves. You pick a half when you play it and use only that half; before then it has both halves' classes, teams and Hero Names. Sort it by its left half.", "source": "CW", "page": 1 },
    { "id": "civil-war_term_size-changing", "name": "Size-Changing", "kind": "keyword", "summary": "The card is 2 cheaper to recruit, or the Villain 2 cheaper to fight, once you have played a card of the shown class this turn.", "source": "CW", "page": 1 },
    { "id": "civil-war_term_phasing", "name": "Phasing", "kind": "keyword", "summary": "On your turn you may trade this card in your hand for the top card of your deck. That trade is neither playing nor drawing a card.", "source": "CW", "page": 1 },
    { "id": "civil-war_term_fortify", "name": "Fortify", "kind": "keyword", "summary": "A Villain parks itself on a named place, such as the Mastermind or a stack, and blocks or changes it until a player defeats that Villain. A place already fortified stays as it is.", "source": "CW", "page": 2 },
