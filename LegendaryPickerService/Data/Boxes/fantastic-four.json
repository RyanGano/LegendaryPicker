    { "id": "fantastic-four_term_focus", "name": "Focus", "kind": "keyword", "summary": "Trade the Recruit shown for the effect it buys. After playing the card you can buy that effect again and again until your turn ends, as long as your Recruit lasts.", "source": "FF", "page": 1 },
