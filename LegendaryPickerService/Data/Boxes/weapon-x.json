   "page": 1
  },
  {
   "id": "weapon-x_term_weapon-x-sequence",
   "name": "Weapon X Sequence",
   "kind": "keyword",
   "summary": "Count the longest unbroken run of different costs among your cards, or the Heroes in the HQ for an Enemy, and gain that much Attack.",
   "source": "WX",
   "page": 1
  },
