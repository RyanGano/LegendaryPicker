 "glossary": [
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_avengers",
   "name": "Avengers",
   "kind": "team",
   "summary": "The team of Earth's Mightiest Heroes. Its icon on a card powers team Superpower abilities.",
   "source": "AW",
   "page": 1
  },
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_crime-syndicate",
   "name": "Crime Syndicate",
   "kind": "team",
   "summary": "A team of Heroes who work outside the law. Its icon on a card powers team Superpower abilities.",
   "source": "AW",
   "page": 1
  },
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_heist",
   "name": "Heist",
   "kind": "keyword",
   "summary": "A gamble resolved as a Villain is revealed: your Heroes' costs are weighed against that Villain's Victory Points, and a good enough match earns the card's bonus.",
   "source": "AW",
   "page": 1
  },
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_double-cross",
   "name": "Double-Cross",
   "kind": "keyword",
   "summary": "Every player shows their hand and discards one of its most expensive cards, but only if another card in that hand costs the same.",
   "source": "AW",
   "page": 1
  },
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_explore",
   "name": "Explore",
   "kind": "keyword",
   "summary": "Swap an HQ Hero to the bottom of the Hero Deck, reveal two new Heroes, and pick one to fill the space. The pick is the Found Hero, which can switch on extra effects.",
   "source": "AW",
   "page": 1
  },
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_size-changing",
   "name": "Size-Changing",
   "kind": "keyword",
   "summary": "Playing Heroes of the Classes listed on the card this turn makes it cheaper to recruit, or, on a Villain, easier to fight.",
   "source": "AW",
   "page": 1
  },
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_microscopic-size-changing",
   "name": "Microscopic Size-Changing",
   "kind": "keyword",
   "summary": "A stronger Size-Changing: each listed Class icon matched this turn cuts the cost by 2, and a Villain's Attack falls the same way. Recruiting below zero gives Recruit points.",
   "source": "AW",
   "page": 1
  },
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_antics",
   "name": "Antics",
   "kind": "keyword",
   "summary": "A bonus available only as you play the card, if you have at least three cards costing 1 or 2, or with Size-Changing, in play or hand, counting the card itself.",
   "source": "AW",
   "page": 1
  },
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_ambush-scheme",
   "name": "Ambush Scheme",
   "kind": "keyword",
   "summary": "A Scheme card shuffled into the Villain Deck with its Villain Group. Once revealed it sits beside the main Scheme, and each Scheme Twist then triggers both Schemes.",
   "source": "AW",
   "page": 1
  },
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_conqueror",
   "name": "Conqueror",
   "kind": "keyword",
   "summary": "The card names a city space and a bonus, and gets that much extra Attack whenever any Villain stands in that space.",
   "source": "AW",
   "page": 1
  },
  {
   "id": "marvel-studios-ant-man-and-the-wasp_term_transform",
   "name": "Transform",
   "kind": "keyword",
   "summary": "The card flips to its other side. A Transforming Mastermind turns over when its Master Strike or Tactic says so.",
   "source": "AW",
   "page": 1
  }
 ]
}