  {
   "id": "2099_term_cyber-mod",
   "name": "Cyber-Mod",
   "kind": "keyword",
   "summary": "An ability that works only while the listed Class icons are in your Victory Pile. For Villains and Masterminds, the Escape Pile is checked instead.",
   "source": "OT",
   "page": 1
  },
  {
   "id": "2099_term_fated-future",
   "name": "Fated Future",
   "kind": "keyword",
   "summary": "When you play the card, you may put it on the bottom of your deck instead of your discard pile, so it comes back sooner.",
   "source": "OT",
   "page": 1
  },
  {
   "id": "2099_term_undercover",
   "name": "Undercover",
   "kind": "keyword",
   "summary": "Sending a card Undercover puts it into your Victory Pile, which is what switches on your Cyber-Mods.",
   "source": "OT",
   "page": 1
  },
  {
   "id": "2099_term_uru-enchanted-weapons",
   "name": "Uru-Enchanted Weapons",
   "kind": "keyword",
   "summary": "Before you fight, reveal that many Villain Deck cards. Their Victory Points are added to the enemy's Attack, then the cards go back under the deck.",
   "source": "OT",
   "page": 1
  },
  {
   "id": "2099_term_fight-or-fail",
   "name": "Fight or Fail",
   "kind": "keyword",
   "summary": "The effect happens whether the fight is won or lost, which matters because Uru-Enchanted Weapons can make a fight fail.",
   "source": "OT",
   "page": 1
  },
  {
   "id": "2099_term_adapting-mastermind",
   "name": "Adapting Mastermind",
   "kind": "keyword",
   "summary": "A Mastermind made only of Tactics, where the face-up top Tactic is the one in play. To Adapt, shuffle the Tactics and turn a random one up on top.",
   "source": "OT",
   "page": 1
  }
