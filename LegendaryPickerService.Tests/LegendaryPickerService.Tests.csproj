<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- A made-up expansion beside a copy of the core box, for multi-box tests. -->
  <ItemGroup>
    <None Include="Fixtures\Boxes\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LegendaryPickerService\Data\Boxes\core.json" Link="Fixtures\Boxes\core.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A made-up expansion whose Schemes and Mastermind add to setup counts, beside a copy of the core box. -->
  <ItemGroup>
    <None Include="Fixtures\SetupEffects\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LegendaryPickerService\Data\Boxes\core.json" Link="Fixtures\SetupEffects\core.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A made-up expansion whose Schemes move cards between stacks and decks, beside a copy of the core box. -->
  <ItemGroup>
    <None Include="Fixtures\CardMoves\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LegendaryPickerService\Data\Boxes\core.json" Link="Fixtures\CardMoves\core.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegendaryPickerService\LegendaryPickerService.csproj" />
  </ItemGroup>

</Project>